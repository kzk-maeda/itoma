aws_account_id    = "123456789012"
name              = "itoma-e2e"
github_repository = "kzk-maeda/itoma"
github_branches   = ["main"]

# Reuse by default. Set true only when the account has no existing GitHub OIDC provider.
create_github_oidc_provider = false

# Replace with catalogue ARNs of 1-3 PUBLIC iOS 18+ devices selected by the owner.
device_arns = ["arn:aws:devicefarm:us-west-2::device:REPLACE_WITH_DEVICE_ID"]
