{
  "expo": {
    "name": "itoma",
    "slug": "itoma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "itoma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.example.itoma"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F3F0",
          "dark": { "backgroundColor": "#1B1C1A" }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "ItomaSQLite",
                "path": "../packages/itoma-storage"
              },
              {
                "name": "ItomaCore",
                "path": "../packages/itoma-core"
              },
              {
                "name": "ItomaStorage",
                "path": "../packages/itoma-storage"
              },
              {
                "name": "ItomaHistory",
                "path": "../packages/itoma-storage"
              },
              {
                "name": "ItomaControl",
                "path": "../packages/itoma-control"
              },
              {
                "name": "ItomaScreenTime",
                "path": "../packages/itoma-screen-time"
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
