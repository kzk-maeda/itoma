{
  "name": "itoma-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "preview": "npm run build && wrangler dev --ip 127.0.0.1 --port 8788",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "test:http": "node test/http-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.157.0"
  }
}
